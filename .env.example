OCR_HOST=127.0.0.1
OCR_PORT=8095
TESSERACT_CMD=
EASYOCR_MODULE_PATH=

# Informational preference: auto, cpu, cuda, rocm
OCR_ACCELERATOR=auto


# Optional AI super-resolution.
# Leave SUPERRES_MODEL_PATH empty to use models/EDSR_x2.pb automatically.
SUPERRES_MODEL_PATH=
SUPERRES_MODEL_NAME=edsr
SUPERRES_MODEL_SCALE=2
